{
  "name": "homegames-core",
  "version": "1.4.3",
  "description": "Play games at home",
  "directories": {
    "lib": "lib"
  },
  "pkg": {
    "assets": "src/**/*"
  },
  "scripts": {
    "test": "node testRunner.js",
    "test:host-access": "node --test test/host-access.test.cjs",
    "stage:runtime": "node tools/stage-local-runtime.cjs",
    "audit:runtime": "node tools/audit-runtime-candidate.cjs",
    "test:sessions": "node testRunner.js ./test/session/*.test.js ./test/GamepadInput.test.js ./test/QuickPointerInput.test.js ./test/SaveGames.test.js ./test/SessionForkGate.test.js ./test/web/*.test.js",
    "start": "node index.js",
    "develop": "node hotload.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homegamesio/homegames.git"
  },
  "keywords": [
    "homegames"
  ],
  "author": "Joseph Garcia",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/homegamesio/homegames/issues"
  },
  "homepage": "https://github.com/homegamesio/homegames#readme",
  "dependencies": {
    "@peculiar/x509": "1.14.3",
    "acorn": "^8.11.3",
    "homegames-client": "0.2.1",
    "homegames-common": "1.7.4",
    "squish-150": "npm:squishjs@1.5.0",
    "ws": "7.5.13"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "homepad": "0.2.1"
  },
  "overrides": {
    "homepad": "0.2.1",
    "homegames-common": {
      ".": "$homegames-common",
      "ws": "7.5.13"
    }
  }
}
